<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title>Connexion - Theosusan-PKI</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/main.css" />
  <% if (!loginEnabled) { %>
    <script>
      window.location.href = '/oidc/login';
    </script>
    <% } %>
  </head>
  <body>
    <% if (loginEnabled) { %>
      
      <header class="fixed-header">
        <div class="container-fluid d-flex justify-content-between align-items-center p-0">
          <span class="navbar-brand mb-0 h5" style="color: #e0e0e0;">Theosusan-PKI</span>
        </div>
      </header>
      
      <div class="row mt-5" style="width: 100vw; margin: 0;">
        <div class="col-4"></div>
        <div class="col-4">
          <h2 class="mb-4 text-center">Login</h2>
          
          <form id="loginForm" class="mb-4">
            <div class="row g-3">
              <div class="col-12">
                <label for="username" class="form-label">Nom d'utilisateur</label>
                <input type="text" id="username" required class="form-control" />
              </div>
              <div class="col-12">
                <label for="password" class="form-label">Mot de passe</label>
                <input type="password" id="password" required class="form-control" />
              </div>
              <div class="col-12 d-flex">
                <button type="submit" class="btn btn-primary fw-bold w-100 mt-3">Se connecter</button>
              </div>
            </div>
          </form>
          
          <hr />
          <button onclick="window.location.href='/oidc/login'"class="btn btn-primary fw-bold w-100" id="authentik">Connexion via Authentik</button>
        </div>
        <div class="col-4"></div>
      </div>
      
      <!-- Toast container -->
      <div class="position-fixed top-0 end-0 p-3" style="z-index: 1080;">
        <div id="liveToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
          <div class="d-flex">
            <div id="toastBody" class="toast-body"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fermer"></button>
          </div>
        </div>
      </div>
      
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
      <script src="/js/main.js"></script>
      <script>
        const form = document.getElementById('loginForm');
        
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          const username = document.getElementById('username').value.trim();
          const password = document.getElementById('password').value;
          
          try {
            const response = await fetch('/login', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ username, password })
            });
            
            const data = await response.json();
            
            if (response.ok) {
              window.location.href = '/dashboard';
            } else {
              showToast('Utilisateur ou mot de passe incorrect', false);
            }
          } catch {
            showToast('Erreur réseau ou serveur', false);
          }
        });
      </script>
      <% } %>
    </body>
    </html>
