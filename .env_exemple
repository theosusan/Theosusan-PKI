DB_HOST=yourdbhost
DB_NAME=mariadb
DB_USER=bdd_user
DB_PASSWORD=bdd_password
SECRET_KEY=[openssl rand -hex 32]
OIDC_CLIENT_ID=client_id
OIDC_CLIENT_SECRET=client_secret
OIDC_ISSUER_URL=issuer_url
OIDC_REDIRECT_URI=https://theosusan-pki.theosusan.fr/oidc/callback
BASE_LOGIN_METHOD=true
LOG_LEVEL=info
COOKIE_SECURE=false